{
  "name": "arcadepro-game-stub-tapper",
  "version": "0.0.1",
  "description": "ArcadePro game template (example: Stub Tapper)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run lint && npm run typecheck && vite build && node scripts/write-manifest.mjs",
    "build:core": "vite build --config vite.core.config.ts",
    "harness": "npm run build && vite --config vite.harness.config.ts",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@arcadepro/game-sdk": "github:simba-io/arcadepro-game-sdk#v0.2.0",
    "pixi.js": "^8.8.1",
    "simple-sound-editor": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.12"
  }
}
